# Frontend env variables.
# Copy this file to .env.development for local development.
#
# Two groups:
#   1) VITE_*   — попадают в клиентский бандл (доступны через import.meta.env).
#   2) DEV_*    — читаются только в vite.config.ts (loadEnv), в бандл НЕ попадают.

# ─── Клиентские (VITE_*) ───
# Базовый URL для axios. В dev — относительный путь, идёт через прокси Vite.
# В prod — полный URL бэкенда, например https://api.example.com/api.
VITE_API_BASE_URL=/api

# URL для Socket.IO (не проксируется Vite — нужен прямой адрес бэкенда).
# В prod — то же происхождение, что и API, но без /api суффикса.
VITE_SOCKET_URL=http://localhost:3000

# URL S3-бакета с датасетами бенчмарков (страница /guide, инструкция по скачиванию).
VITE_S3_DATASETS_URL=s3://benchfactory-datasets

# ─── Серверные (только Vite, dev-only) ───
DEV_HOST=0.0.0.0
DEV_PORT=5174
# Префикс, по которому Vite проксирует запросы. Должен совпадать с VITE_API_BASE_URL.
DEV_PROXY_PREFIX=/api
# Адрес бэкенда, куда Vite пробрасывает запросы /api/*.
DEV_PROXY_TARGET=http://localhost:3000
